# ~/.ssh/config — modular SSH configuration entry point.
#
# Host definitions live in per-file drop-ins under ~/.ssh/config.d/*.conf,
# pulled in by the Include below. Add a new *.conf there rather than editing
# this file, so hosts stay grouped and this entry point stays minimal.
#
# Include is first on purpose: SSH uses the FIRST matching value for each key,
# so drop-in entries take precedence over anything added after this line.
#
# Put machine-local / private host entries in ~/.ssh/config.d/*.conf. That dir is
# NOT tracked by this dotfiles repo (stow links only this file to ~/.ssh/config),
# so those entries survive `git pull` / `git reset --hard` across machines and are
# never clobbered by the repo — while still taking precedence via the rule above.

Include ~/.ssh/config.d/*.conf

Host *
  SendEnv LANG LC_*
  MACs hmac-md5,hmac-sha1
  ForwardX11 no
  ForwardAgent yes
  AddressFamily inet
  ServerAliveInterval 15
  ConnectTimeout 20

Host bastion
    User ec2-user
    Hostname bastion.domain.com
    IdentityFile ~/.ssh/id_rsa
