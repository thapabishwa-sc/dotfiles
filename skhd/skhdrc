# APPS #
#
# Safari
alt - s : run-external "open" "-a" "/Applications/Safari.app/Contents/MacOS/Safari"

# Telegram
alt - t : run-external "open" "-a" "/Applications/Telegram.app/Contents/MacOS/Telegram"

# Obsidian
alt - o : run-external "open" "-a" "/Applications/Obsidian.app/Contents/MacOS/Obsidian"

# Show date
alt - d : osascript ~/.config/skhd/applescripts/pop.scpt

# Close notifications
ralt - n : osascript ~/.config/skhd/applescripts/notifications.scpt

# Notion
lalt - n : run-external "open" "-a" "/Applications/Notion.app/Contents/MacOS/Notion"

# Min
ralt - m : run-external "open" "-a" "/Applications/Min.app/Contents/MacOS/Min"

# QuickTime
alt - q : run-external "open" "-a" `/System/Applications/QuickTime Player.app/Contents/MacOS/QuickTime Player`

# FinalCut
alt - f : run-external "open" "-a" `/Applications/Final Cut Pro.app/Contents/MacOS/Final Cut Pro`

# Ghostty
alt - g : run-external "open" "-a" "/Applications/Ghostty.app"


# ═════════════════════════════════════════════════════════════════════════════
# WINDOW MANAGEMENT — ported from aerospace/aerospace.toml (drives yabai)
# Lines marked [SA] need the scripting addition (partial SIP disable). See yabairc.
# None of these collide with the app launchers above (s/t/o/d/n/m/q/f/g).
# ═════════════════════════════════════════════════════════════════════════════

# --- Layout ------------------------------------------------------------------
alt - 0x2C : yabai -m space --layout bsp; yabai -m space --rotate 90  # alt-/  rotate layout (forces bsp first; needs 2+ tiled windows)
alt - 0x2B : yabai -m space --layout stack             # alt-,  accordion-like (stack) — needs 2+ tiled windows
alt - p    : yabai -m space --layout bsp               # back to tiles (inverse of alt-,)
alt - m    : yabai -m window --toggle zoom-fullscreen  # maximize (non-native)
shift + alt - m : "$HOME"/.config/yabai/master_stack.sh  # rebuild focused space -> master-left + right-stack
shift + alt - f : yabai -m window --toggle float --grid 4:4:1:1:2:2  # float<->tile

# --- Focus (hjkl, wrap to the far side of the space) -------------------------
alt - h : yabai -m window --focus west  || yabai -m window --focus last
alt - j : yabai -m window --focus south || yabai -m window --focus stack.next || yabai -m window --focus first
alt - k : yabai -m window --focus north || yabai -m window --focus stack.prev || yabai -m window --focus last
alt - l : yabai -m window --focus east  || yabai -m window --focus first

# --- Move the focused window (swap, with wrap fallback) ----------------------
shift + alt - h : yabai -m window --swap west  || yabai -m window --swap last
shift + alt - j : yabai -m window --swap south || yabai -m window --swap first
shift + alt - k : yabai -m window --swap north || yabai -m window --swap last
shift + alt - l : yabai -m window --swap east  || yabai -m window --swap first

# --- Build splits (aerospace join-with -> set insertion point) ---------------
shift + alt - 0x7B : yabai -m window --insert west    # alt-shift-left
shift + alt - 0x7D : yabai -m window --insert south   # alt-shift-down
shift + alt - 0x7E : yabai -m window --insert north   # alt-shift-up
shift + alt - 0x7C : yabai -m window --insert east    # alt-shift-right

# --- Monitors ----------------------------------------------------------------
ctrl + alt - h : yabai -m display --focus west  || yabai -m display --focus last
ctrl + alt - l : yabai -m display --focus east  || yabai -m display --focus first
# Send focused window to the other monitor and follow it (wraps around).
ctrl + shift + alt - h : yabai -m window --display west  || yabai -m window --display last;  yabai -m display --focus west  || yabai -m display --focus last
ctrl + shift + alt - l : yabai -m window --display east  || yabai -m window --display first; yabai -m display --focus east  || yabai -m display --focus first

# --- Spaces -------------------------------------------------------------------
# Try yabai (works once SA_ENABLED=yes + SIP step); otherwise fall back to
# macOS's native space switch via ctrl+number.
# REQUIRED for the fallback: System Settings -> Keyboard -> Shortcuts ->
# Mission Control -> enable "Switch to Desktop 1..N" (they're off by default),
# and create that many desktops in Mission Control. macOS only maps 1-9; alt-0
# (Desktop 10) only works once SIP/SA is on.
alt - 1 : yabai -m space --focus 1 2>/dev/null  || skhd -k "ctrl - 1"
alt - 2 : yabai -m space --focus 2 2>/dev/null  || skhd -k "ctrl - 2"
alt - 3 : yabai -m space --focus 3 2>/dev/null  || skhd -k "ctrl - 3"
alt - 4 : yabai -m space --focus 4 2>/dev/null  || skhd -k "ctrl - 4"
alt - 5 : yabai -m space --focus 5 2>/dev/null  || skhd -k "ctrl - 5"
alt - 6 : yabai -m space --focus 6 2>/dev/null  || skhd -k "ctrl - 6"
alt - 7 : yabai -m space --focus 7 2>/dev/null  || skhd -k "ctrl - 7"
alt - 8 : yabai -m space --focus 8 2>/dev/null  || skhd -k "ctrl - 8"
alt - 9 : yabai -m space --focus 9 2>/dev/null  || skhd -k "ctrl - 9"
alt - 0 : yabai -m space --focus 10 2>/dev/null || skhd -k "ctrl - 0"

# Move focused window to a space and follow it.                                  [SA]
shift + alt - 1 : yabai -m window --space 1  2>/dev/null;  yabai -m space --focus 1 2>/dev/null
shift + alt - 2 : yabai -m window --space 2  2>/dev/null;  yabai -m space --focus 2 2>/dev/null
shift + alt - 3 : yabai -m window --space 3  2>/dev/null;  yabai -m space --focus 3 2>/dev/null
shift + alt - 4 : yabai -m window --space 4  2>/dev/null;  yabai -m space --focus 4 2>/dev/null
shift + alt - 5 : yabai -m window --space 5  2>/dev/null;  yabai -m space --focus 5 2>/dev/null
shift + alt - 6 : yabai -m window --space 6  2>/dev/null;  yabai -m space --focus 6 2>/dev/null
shift + alt - 7 : yabai -m window --space 7  2>/dev/null;  yabai -m space --focus 7 2>/dev/null
shift + alt - 8 : yabai -m window --space 8  2>/dev/null;  yabai -m space --focus 8 2>/dev/null
shift + alt - 9 : yabai -m window --space 9  2>/dev/null;  yabai -m space --focus 9 2>/dev/null
shift + alt - 0 : yabai -m window --space 10 2>/dev/null;  yabai -m space --focus 10 2>/dev/null

alt - tab         : yabai -m space --focus recent 2>/dev/null                            # bounce to last space  [SA]
shift + alt - tab : yabai -m space --display next 2>/dev/null || yabai -m space --display first 2>/dev/null  # push space to next monitor  [SA]

# --- Mode declarations (`@` = capture unbound keys) --------------------------
:: default
:: resize @
:: service @

# --- Enter modes -------------------------------------------------------------
alt - r            ; resize                                        # alt-r        -> resize mode
shift + alt - 0x29 ; service                                       # alt-shift-;  -> service mode

# ═════════════════════════════════════════════════════════════════════════════
# RESIZE MODE  (enter: alt-r — esc/enter to exit)  — aerospace [mode.resize]
# ═════════════════════════════════════════════════════════════════════════════
resize < h : yabai -m window --resize left:-50:0  || yabai -m window --resize right:-50:0
resize < l : yabai -m window --resize right:50:0  || yabai -m window --resize left:50:0
resize < k : yabai -m window --resize bottom:0:-50 || yabai -m window --resize top:0:-50
resize < j : yabai -m window --resize bottom:0:50  || yabai -m window --resize top:0:50
resize < shift - h : yabai -m window --resize left:-80:0   || yabai -m window --resize right:-80:0
resize < shift - l : yabai -m window --resize right:80:0   || yabai -m window --resize left:80:0
resize < shift - k : yabai -m window --resize bottom:0:-80 || yabai -m window --resize top:0:-80
resize < shift - j : yabai -m window --resize bottom:0:80  || yabai -m window --resize top:0:80
resize < 0x1B : yabai -m window --resize left:-50:0 || yabai -m window --resize right:-50:0  # '-' shrink
resize < 0x18 : yabai -m window --resize right:50:0 || yabai -m window --resize left:50:0    # '=' grow
resize < 0 : yabai -m space --balance                  # equalize all (stays in mode, like aerospace)
resize < escape ; default
resize < return ; default

# ═════════════════════════════════════════════════════════════════════════════
# SERVICE MODE  (enter: alt-shift-; )  — aerospace [mode.service]
# Action keys run, then synthesize 'return' to drop back to default (skhd idiom).
# ═════════════════════════════════════════════════════════════════════════════
service < r : yabai -m space --balance; skhd -k "return"                  # reset/flatten tree ~ balance
service < f : yabai -m window --toggle float; skhd -k "return"            # toggle floating/tiling
# close-all-windows-but-current: close every other window in this space.
service < 0x33 : cur=$(yabai -m query --windows --window | sed -n 's/.*"id":\([0-9]*\).*/\1/p'); for w in $(yabai -m query --windows --space | sed -n 's/.*"id":\([0-9]*\).*/\1/p'); do [ "$w" != "$cur" ] && yabai -m window "$w" --close; done; skhd -k "return"
service < escape : yabai --restart-service; skhd --reload               # reload yabai + skhd config (drops to default)
service < return ; default
